{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Trackhop server on Azure Container Apps: one small always-on replica, HTTPS, data on an Azure Files share. https://trackhop.org"
  },
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "trackhop",
      "minLength": 2,
      "maxLength": 32,
      "metadata": { "description": "Name of the app: part of its web address. Lowercase letters, digits and hyphens." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region. A region near you, in the EU if you are in Europe." }
    },
    "userName": {
      "type": "string",
      "defaultValue": "admin",
      "metadata": { "description": "User name to sign in to Trackhop." }
    },
    "password": {
      "type": "securestring",
      "minLength": 8,
      "metadata": { "description": "Password to sign in to Trackhop (at least 8 characters)." }
    },
    "multiUser": {
      "type": "bool",
      "defaultValue": false,
      "metadata": { "description": "Several people on one server, each with their own space (you are the admin)." }
    },
    "imageTag": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": { "description": "Version of the image ghcr.io/xlollx/trackhop." }
    }
  },
  "variables": {
    "storageName": "[concat('trackhop', uniqueString(resourceGroup().id))]",
    "shareName": "trackhop-data",
    "envName": "[concat(parameters('appName'), '-env')]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard_LRS" },
      "kind": "StorageV2",
      "properties": { "minimumTlsVersion": "TLS1_2", "allowBlobPublicAccess": false, "supportsHttpsTrafficOnly": true }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/fileServices/shares",
      "apiVersion": "2023-01-01",
      "name": "[concat(variables('storageName'), '/default/', variables('shareName'))]",
      "dependsOn": [ "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]" ],
      "properties": { "shareQuota": 5 }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('envName')]",
      "location": "[parameters('location')]",
      "properties": {}
    },
    {
      "type": "Microsoft.App/managedEnvironments/storages",
      "apiVersion": "2024-03-01",
      "name": "[concat(variables('envName'), '/trackhopdata')]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', variables('storageName'), 'default', variables('shareName'))]"
      ],
      "properties": {
        "azureFile": {
          "accountName": "[variables('storageName')]",
          "accountKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-01-01').keys[0].value]",
          "shareName": "[variables('shareName')]",
          "accessMode": "ReadWrite"
        }
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "dependsOn": [ "[resourceId('Microsoft.App/managedEnvironments/storages', variables('envName'), 'trackhopdata')]" ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('envName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": { "external": true, "targetPort": 8080, "transport": "auto", "allowInsecure": false },
          "secrets": [ { "name": "songport-password", "value": "[parameters('password')]" } ]
        },
        "template": {
          "containers": [
            {
              "name": "trackhop",
              "image": "[concat('ghcr.io/xlollx/trackhop:', parameters('imageTag'))]",
              "resources": { "cpu": "[json('0.25')]", "memory": "0.5Gi" },
              "env": [
                { "name": "SONGPORT_USER", "value": "[parameters('userName')]" },
                { "name": "SONGPORT_PASSWORD", "secretRef": "songport-password" },
                { "name": "SONGPORT_MULTIUSER", "value": "[if(parameters('multiUser'), 'true', 'false')]" },
                { "name": "SONGPORT_URL", "value": "[concat('https://', parameters('appName'), '.', reference(resourceId('Microsoft.App/managedEnvironments', variables('envName')), '2024-03-01').defaultDomain)]" }
              ],
              "volumeMounts": [ { "volumeName": "data", "mountPath": "/data" } ],
              "probes": [
                { "type": "Liveness", "httpGet": { "path": "/health", "port": 8080 }, "initialDelaySeconds": 20, "periodSeconds": 30 }
              ]
            }
          ],
          "scale": { "minReplicas": 1, "maxReplicas": 1 },
          "volumes": [
            { "name": "data", "storageType": "AzureFile", "storageName": "trackhopdata", "mountOptions": "dir_mode=0777,file_mode=0777,nobrl" }
          ]
        }
      }
    }
  ],
  "outputs": {
    "url": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.App/containerApps', parameters('appName')), '2024-03-01').configuration.ingress.fqdn)]"
    }
  }
}
