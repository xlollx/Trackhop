#!/bin/sh
# prerm script for APPLICATION_PACKAGE: JDK 21 jpackage's own (template.prerm), with the menu steps
# allowed to fail, as in postinst: on a system without a desktop they cannot run, and the package
# must still be removable. jpackage fills in the words in capitals (server/desktop/package.sh).

set -e

package_type=deb
DESKTOP_SCRIPTS
LAUNCHER_AS_SERVICE_SCRIPTS

case "$1" in
    remove|upgrade|deconfigure)
        (
            :
DESKTOP_COMMANDS_UNINSTALL
        ) || true
LAUNCHER_AS_SERVICE_COMMANDS_UNINSTALL
    ;;

    failed-upgrade)
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
