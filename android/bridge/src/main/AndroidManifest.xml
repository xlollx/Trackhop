<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Sign-in screens, started by Trackhop itself: nothing here is reachable from other apps.
             Not remade when the screen turns or the theme changes: the page being filled in stays. -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|navigation"
            android:label="@string/bridge_login_title" />
        <activity
            android:name=".AmazonLoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|navigation"
            android:label="@string/bridge_amazon_title" />
        <activity
            android:name=".WebLoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|navigation" />
        <!-- Google's own page when it blocks the address, shown from the YouTube Music connector. -->
        <activity
            android:name=".VerifyActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|navigation" />
        <!-- setlist.fm's own site, browsed by the person, for the Trackhop builds without their own
             screen for it (Google Play, AppGallery): they start it with the action below, for a
             result, so it is exported here, the one screen of this module that is. It answers only
             Trackhop (it checks who started it). Trackhop's GitHub/F-Droid build has its own screen
             and removes this one from its manifest. -->
        <activity
            android:name=".SetlistBrowseActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="com.xlollx.songport.ytmbridge.SETLIST_BROWSE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Development aid: records the Amazon web player's API calls so a changed method can be fixed. -->
        <activity
            android:name=".AmazonCaptureActivity"
            android:exported="false"
            android:label="@string/bridge_amazon_capture" />

        <!-- Shares the capture file with other apps (read-only, per request). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/bridge_file_paths" />
        </provider>
    </application>
</manifest>
